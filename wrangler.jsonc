{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shaahin12",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c196307e-f4cd-4fe9-ab4b-750a3ee971e0","database_name": "shaahin1234" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "406a48bb3c72406eaecbdcc28e314f3a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
